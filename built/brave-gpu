#!/bin/sh
# Brave with GPU acceleration on FuriOS (Mali/hybris, no DRM render node).
#
# Two separate blockers had to be cleared:
#
# 1. NO RENDER NODE. Chromium's wayland ozone GPU path requires /dev/dri/renderD*;
#    this device has none (Mali is reachable only via /dev/mali0 through
#    libhybris). Without it the GPU process aborts and Chromium blocklists the
#    GPU for the session -- every brave://gpu row reads "Software only".
#      --render-node-override  skips drmGetDevices2 discovery entirely.
#      rendernode-shim.so      answers open64/stat64/drmGetVersion for that path.
#    (Injecting a synthetic device into drmGetDevices2 also worked, but it was
#    visible to every DRM consumer and made the nouveau Vulkan ICD segfault.)
#
# 2. HWC2 COMPOSER CLIENT. Once Chromium has a render node it builds its EGL
#    display via EGL_PLATFORM_GBM, which on hybris always routes to the
#    drmadapter platform regardless of HYBRIS_EGLPLATFORM. drmadapter then calls
#    hwc2_compat_device_new(), and HWC2 allows one composer client per system --
#    mutter already holds it. libhwc2_compat_layer does not fail gracefully; it
#    prints "failed to create composer client" and ABORTS the process.
#      A client never scans out: it renders into gralloc buffers and presents
#      through the compositor. So this uses a drmadapter built with a client-mode
#      gate that skips HWC2 init unless the process really is a compositor.
#      HYBRIS_EGLPLATFORM_DIR scopes that build to Brave alone -- the
#      compositor's own /usr/lib/.../libhybris copy is untouched.
#
# Deliberately NOT used: --in-process-gpu. It survived the composer abort in a
# clean profile, but with a real profile the abort takes the WHOLE browser down.
exec env \
  LD_PRELOAD=/usr/local/lib/rendernode-shim.so \
  HYBRIS_EGLPLATFORM=drmadapter \
  HYBRIS_EGLPLATFORM_DIR=/usr/local/lib/drmadapter-client \
  GBM_BACKEND=hybris \
  GBM_BACKENDS_PATH=/usr/lib/aarch64-linux-gnu/gbm \
  VK_LOADER_DRIVERS_DISABLE='*' \
  /usr/bin/brave-browser-stable \
    --ozone-platform=wayland \
    --render-node-override=/dev/dri/renderD128 \
    --disable-features=Vulkan,VulkanFromANGLE \
    "$@"
